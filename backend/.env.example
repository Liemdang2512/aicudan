# =============================================================
# AI Báo Điện Cư Dân — Backend Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# =============================================================

# --- Môi trường ---
APP_ENV=production

# --- Bảo mật (BẮT BUỘC thay đổi khi production) ---
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Admin mặc định (BẮT BUỘC thay đổi khi production) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Google Gemini AI ---
GEMINI_API_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- CORS: set đúng domain frontend trong production, không dùng * ---
CORS_ORIGINS=https://yourdomain.com

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
MAX_BATCH_SIZE=50
